# BotManager FastAPI backend configuration
# Copy this file to .env (backend/.env) and fill in real values.
# backend/.env is loaded automatically by start.ps1 (see repo root).

# SQLite database file (defaults to backend/botmanager.db regardless of CWD)
DATABASE_URL=sqlite:///./botmanager.db

# Groq LLM API key - required for real AI replies.
# Without a valid key the bot answers with a generic fallback message.
# Get one free at https://console.groq.com
GROQ_API_KEY=

# Default Groq chat model. Used automatically whenever a bot's saved engine is
# missing, was retired/renamed by Groq, or is otherwise unavailable. Must be
# one of: openai/gpt-oss-120b | openai/gpt-oss-20b
GROQ_MODEL=openai/gpt-oss-120b

# JWT signing settings
SECRET_KEY=your_super_secret_jwt_key_here

# Google OAuth (optional - only needed for Gmail/Calendar/Drive tools)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an authorized redirect URI in Google Cloud Console.
GOOGLE_REDIRECT_URI=http://localhost:9999/integrations

# Where /auth/google/callback sends the browser after a direct backend callback
FRONTEND_URL=http://localhost:9999

# Shared token for Laravel -> backend integration proxy calls
RUNTIME_SERVICE_TOKEN=dev-runtime-token
