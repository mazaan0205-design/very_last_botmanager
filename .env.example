GROQ_API_KEY=
RUNTIME_SERVICE_TOKEN=replace-with-a-long-random-server-secret

# Required to store every customer's connected-account tokens safely. Generate once with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INTEGRATION_ENCRYPTION_KEY=

# Google Cloud OAuth app. Add the Google callback URL below in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8001/integrations/google/callback

# Slack OAuth app. Add the Slack callback URL below in Slack app settings.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_OAUTH_REDIRECT_URI=http://127.0.0.1:8001/integrations/slack/callback
